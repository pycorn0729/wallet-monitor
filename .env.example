# Copy to .env and adjust.
WM_SECRET_KEY=change-me-to-a-long-random-string
WM_DATABASE_URL=sqlite:///./wallet_monitor.db
WM_SUBTENSOR_URL=wss://entrypoint-finney.opentensor.ai:443
