# Copy to .env and adjust.
WM_SECRET_KEY=change-me-to-a-long-random-string
WM_DATABASE_URL=sqlite:///./wallet_monitor.db
WM_SUBTENSOR_URL=wss://entrypoint-finney.opentensor.ai:443
WM_ARCHIVE_URL=wss://archive.chain.opentensor.ai:443
# Ignore transfers worth less than this many TAO (stake transfers: TAO value).
WM_MIN_TRANSFER_TAO=0.2
# One-off history backfill: depth (days), blocks per step, and blocks fetched at once.
WM_BACKFILL_DAYS=7
WM_BACKFILL_BATCH_SIZE=100
WM_BACKFILL_CONCURRENCY=10
# Blocks fetched at once when the live watcher catches up after downtime.
WM_WATCHER_CONCURRENCY=5
# Optional: only used by "Import history" on wallet pages.
WM_TAOSTATS_API_KEY=
# Block to start scanning from on first run (empty = current finalized head).
WM_WATCHER_START_BLOCK=
WM_WATCHER_ENABLED=true
WM_BALANCE_REFRESH_SECONDS=300
